# API server
APP_ENV=development
DATABASE_URL=postgres://retailos:retailos@localhost:5432/retailos?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
HTTP_ADDR=:8080
COOKIE_SECURE=false
FRONTEND_DIR=../web/dist
APP_BASE_URL=http://localhost:5180

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

# Brevo SMTP (optional; configure all five or leave all empty)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your-brevo-login
SMTP_PASSWORD=replace-with-brevo-smtp-key
SMTP_FROM=demo@example.com
